# ------------------------------------------------------------------
# Agentic RAG Assistant configuration
# Copy this file to .env and adjust what you need.
#
# The default looks for a local Ollama server and
# uses it when found. Without Ollama, the deterministic offline mock
# takes over, so the project always runs. Tests and CI rely on that
# mock fallback, so no keys are ever required.
# ------------------------------------------------------------------

# LLM provider: auto | ollama | mock | openai | azure | anthropic | openai_compatible
LLM_PROVIDER=auto

# One model name for whichever provider is active, overriding the
# provider-specific settings below. Sent to the endpoint untouched, since
# hosted endpoints often serve names the public APIs do not.
# Run `rag models` to see what your endpoint actually offers.
# LLM_MODEL=claude-sonnet-4-6

# Optional two-tier routing. Planning, splitting, rewriting, and judging
# are mechanical and can use the cheaper model. Writing the answer and
# verifying it use the stronger one. Leave both unset to send everything
# to LLM_MODEL.
# LLM_MODEL_FAST=deepseek-flash
# LLM_MODEL_DEEP=deepseek-v4-pro
# Any single role can be pinned, which beats both settings above:
# LLM_MODEL_PLAN=  LLM_MODEL_DECOMPOSE=  LLM_MODEL_REWRITE=
# LLM_MODEL_SYNTHESIZE=  LLM_MODEL_VERIFY=  LLM_MODEL_JUDGE=  LLM_MODEL_VISION=

# --- Ollama (local, free, the default real provider) ---
# With LLM_PROVIDER=auto or ollama, the server is probed at
# OLLAMA_BASE_URL and the best installed model is picked automatically.
# Pin a specific one with OLLAMA_MODEL.
# Recommended model: ollama pull qwen2.5:7b-instruct
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=

# --- OpenAI (or any OpenAI-compatible gateway via openai_compatible) ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# --- Azure OpenAI ---
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-06-01

# --- DeepSeek ---
# Set LLM_PROVIDER=deepseek. Model names come from LLM_MODEL, or the
# tiered settings above when you want a cheap model for the mechanical
# roles and a stronger one for writing and checking the answer.
DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# --- Claude (Anthropic) ---
# Set LLM_PROVIDER=anthropic to use it. ANTHROPIC_BASE_URL points at a
# private or self-hosted endpoint instead of the public API, in which case
# the model name may differ from the public one, so check `rag models`.
ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# Gateways often serve a suffixed name, e.g. claude-sonnet-5@default, and
# whatever you put here is sent through untouched.
ANTHROPIC_MODEL=claude-sonnet-4-6

# Optional JSON object of extra HTTP headers, useful for corporate
# LLM gateways, e.g. {"Ocp-Apim-Subscription-Key": "..."}
LLM_EXTRA_HEADERS=

# Sampling temperature and request timeout (seconds) for real providers
# Planning and synthesis temperature. The verifier, judge, and decomposer
# always run at 0.0. Leave this BLANK (LLM_TEMPERATURE=) to drop the field
# from requests entirely, which some hosted models require.
LLM_TEMPERATURE=0.1
REQUEST_TIMEOUT=60

# Embeddings provider: local | sbert | multilingual | openai
# local        = built-in hashed TF embedder, zero dependencies, offline
# sbert        = sentence-transformers (pip install sentence-transformers)
# multilingual = sentence-transformers with a multilingual model, for corpora
#                or questions that are not in English
# openai       = OpenAI-compatible /embeddings endpoint
EMBEDDINGS_PROVIDER=local
SBERT_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Used when EMBEDDINGS_PROVIDER=multilingual. Downloads on first use, about
# 470 MB, 384 dimensions, covers roughly 100 languages. Any
# sentence-transformers model name works here.
MULTILINGUAL_EMBEDDING_MODEL=intfloat/multilingual-e5-small
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Language of the answer. auto follows the question, which is the default and
# what most people want. Set a code (en, de, ar, zh, ur) to pin every answer
# to one language regardless of what was asked.
ANSWER_LANGUAGE=auto

# Web search provider: ddgs | tavily | fixture | none
# ddgs is keyless DuckDuckGo search and on by default: the agent decides
# per question whether the web is needed at all. fixture reads
# data/web_fixtures.json and exists for offline tests and demos.
SEARCH_PROVIDER=ddgs
TAVILY_API_KEY=

# Web search fixtures used when SEARCH_PROVIDER=fixture (tests, offline demos)
WEB_FIXTURES_PATH=data/web_fixtures.json

# Retrieval and context assembly
# hybrid fuses BM25 keyword scores with vector similarity (RRF); vector
# and bm25 run one retriever alone
RETRIEVAL_MODE=hybrid
RETRIEVAL_K=5
CONTEXT_TOKEN_BUDGET=2200

# Reranking in context assembly: none | cross-encoder
# none           rank by embedding similarity plus rank fusion (default)
# cross-encoder  a model reads question and passage together and scores
#                relevance more precisely, at the cost of one model pass
#                per candidate. Needs: pip install -e ".[rerank]"
RERANKER=none
# English default. For other languages use a multilingual cross-encoder such
# as cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Chunking
# structure keeps headings and sentences intact (best for documents).
# length uses fixed windows, better for transcripts and logs.
# PDF page images. Charts, schematics, and layout-heavy tables are invisible
# to text extraction, so pages can be rendered and described by a vision
# model, then indexed alongside the text.
#   off   never
#   auto  only when text extraction came back thin (scans, figure pages)
#   on    every PDF page
# Needs the extra: pip install -e ".[vision]"
PDF_VISION=auto
VISION_MAX_PAGES=20
VISION_SCALE=2.0
# How many page images may be attached when writing an answer
VISION_CONTEXT_PAGES=2

# How pages are ranked once they are indexed as images.
#   description  score the page description written at ingest (no extra install)
#   colpali      embed the page image itself and rank by late interaction
# colpali needs the extra: pip install -e ".[colpali]"  (pulls in torch)
VISUAL_RETRIEVER=description
# Blank uses colSmol, the small member of the family that runs on a CPU.
# COLPALI_MODEL=vidore/colSmol-256M
# COLPALI_DEVICE=          # blank picks cuda when present, else cpu
COLPALI_BATCH_SIZE=2

CHUNK_STRATEGY=structure
CHUNK_TARGET_CHARS=900
CHUNK_OVERLAP_CHARS=150

# Structured data catalog used by the knowledge_base tool
CATALOG_PATH=data/structured/catalog.json

# Database for the sql_query tool (text-to-SQL). The planner writes one
# read-only SELECT from the schema shown in its prompt.
#   .sql                  a script, loaded into an in-memory database at startup
#   .db .sqlite .sqlite3  an existing SQLite file, opened read-only in place
# Blank turns the tool off.
SQL_DATABASE_PATH=data/structured/sales.sql

# Agent loop and verification
MAX_AGENT_STEPS=6
MAX_REFINE_ATTEMPTS=1
MIN_GROUNDEDNESS=0.7
VERIFIER_MODE=auto

# API security: empty keeps the local API open. Set a token before
# exposing the server beyond your machine; every endpoint except
# /api/health then requires the header  Authorization: Bearer <token>
API_AUTH_TOKEN=

# Maximum size per uploaded file for /api/upload (megabytes)
UPLOAD_MAX_MB=25

# Folders /api/ingest is allowed to read, comma separated. Anything outside
# them is refused, so the API cannot be pointed at arbitrary server paths.
# The uploads folder is always allowed. `rag ingest` on the CLI is not limited.
INGEST_ROOTS=data

# Parallel retrieval. A question is split into at most MAX_BRANCHES
# independent sub-questions that are researched at the same time.
# Set MAX_BRANCHES=1 to turn decomposition off entirely.
MAX_BRANCHES=3
# Tool calls allowed in total across every branch of one question
MAX_TOTAL_AGENT_STEPS=12

# Storage location for the vector index, uploads, and eval reports
STORAGE_DIR=storage

# --- Knowledge graph ---
# Entities and relationships are extracted at ingest and stored beside the
# vector index. Turning this off leaves the rest of ingest untouched.
GRAPH_EXTRACTION=true
# offline | llm | auto. offline is rules and patterns: no key, no network,
# no cost. llm asks the configured provider and reads far more, at one call
# per chunk. auto stays offline unless LLM_PROVIDER was set deliberately.
GRAPH_EXTRACTOR=auto
# sqlite (embedded, zero setup) or neo4j (optional extra)
GRAPH_STORE=sqlite
# How many relationships graph_search follows by default.
GRAPH_HOPS=2
GRAPH_MAX_ENTITIES_PER_CHUNK=12
GRAPH_ALIAS_PATH=data/graph_aliases.json
# Only for GRAPH_STORE=neo4j; needs pip install "agentic-rag-assistant[neo4j]"
NEO4J_URI=
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=
