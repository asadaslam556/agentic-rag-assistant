# Normalise line endings so a Windows checkout does not commit CRLF
* text=auto eol=lf

# Windows-only files keep CRLF
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary assets must never be touched
*.png binary
*.jpg binary
*.pdf binary
*.ico binary

# Keep generated and vendored files out of language statistics
frontend/dist/** linguist-generated=true
docs/*.png binary
